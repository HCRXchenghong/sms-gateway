# SMS Gateway example configuration
# Copy to .env and adjust for production.

SMSGW_HOST=0.0.0.0
SMSGW_PORT=8443

# Storage
SMSGW_DATA_DIR=/var/lib/sms-gateway
SMSGW_LOG_DIR=/var/log/sms-gateway
SMSGW_CONFIG_DIR=/etc/sms-gateway
SMSGW_SESSION_SECRET_FILE=/etc/sms-gateway/secret.key

# Real hardware mode
SMSGW_MOCK_MODEM=false
# Development preview only. Keep 1 unless you intentionally test multiple devices.
# SMSGW_MOCK_MODEM_COUNT=1
# Optional: force a specific AT port, otherwise auto-discovery is used.
# SMSGW_MODEM_AT_PORT=/dev/ttyUSB2

# Auth and retention
SMSGW_SESSION_MAX_AGE_SECONDS=28800
SMSGW_MESSAGE_RETENTION_DAYS=7

# API send rate limit per key
SMSGW_API_SEND_RATE_LIMIT_PER_MINUTE=30

# Optional TLS paths when not using a reverse proxy.
# SMSGW_TLS_CERT=/etc/sms-gateway/tls/fullchain.pem
# SMSGW_TLS_KEY=/etc/sms-gateway/tls/privkey.pem
