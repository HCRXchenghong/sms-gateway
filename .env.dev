# Development configuration for local UI preview.
# Copy/rename to .env and `pip install -r requirements.txt` first.
SMSGW_HOST=127.0.0.1
SMSGW_PORT=8080
SMSGW_DATA_DIR=./_devdata
SMSGW_LOG_DIR=./_devdata/log
SMSGW_CONFIG_DIR=./_devdata/etc
SMSGW_SESSION_SECRET_FILE=./_devdata/etc/secret.key
SMSGW_MOCK_MODEM=true
